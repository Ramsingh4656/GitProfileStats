# ══════════════════════════════════════════════════════════════════════
# GitProfileStats — Environment Configuration
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_BASE_URL=http://localhost:3000

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── GitHub ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_TOKEN=your_github_personal_access_token
SESSION_SECRET=replace_with_at_least_32_random_characters
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ── Web Frontend Client ─────────────────────────────────────────────────
# The URL of the backend API service (defaults to http://localhost:4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Bundle Analyzer setting (optional, set to true to trigger bundle analysis)
ANALYZE=false

