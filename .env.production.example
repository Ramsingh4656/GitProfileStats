# ══════════════════════════════════════════════════════════════════════
# GitProfileStats — Production Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════
# Use this template to configure environment variables on your production platforms.
# DO NOT commit any file containing active production credentials to version control.
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# 1. BACKEND SERVICE CONFIGURATION (Railway or Render)
# ──────────────────────────────────────────────────────────────────────

# Set the environment to production to optimize build settings and logging
NODE_ENV=production

# The port where the backend API will listen.
# Render defaults to 10000; Railway dynamically injects PORT.
PORT=4000

# The base URL of your deployed Vercel frontend app.
# Used for CORS validation and redirects. (No trailing slash)
# Example: https://git-profile-stats.vercel.app
WEB_BASE_URL=https://your-frontend-domain.vercel.app

# Production log level (recommend info or warn to keep logs clean)
LOG_LEVEL=info

# ── GitHub OAuth Credentials ──
# Create a GitHub OAuth App at: GitHub -> Settings -> Developer Settings -> OAuth Apps
# Set Authorization callback URL to: https://your-backend-api.com/api/v1/auth/github/callback

GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend-api.com/api/v1/auth/github/callback

# ── GitHub Personal Access Token (Fallback) ──
# A Personal Access Token (classic or fine-grained) used for public API calls and to prevent rate-limiting.
# Note: Ensure it has 'read:user' and 'repo' permissions if required to fetch details.
GITHUB_TOKEN=your_production_github_personal_access_token
SESSION_SECRET=replace_with_at_least_32_random_characters
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token


# ──────────────────────────────────────────────────────────────────────
# 2. FRONTEND SERVICE CONFIGURATION (Vercel)
# ──────────────────────────────────────────────────────────────────────

# The URL of your deployed backend API on Railway or Render.
# Used by the frontend client to query statistics and generate SVGs. (No trailing slash)
# Example: https://git-profile-stats-api.railway.app
NEXT_PUBLIC_API_URL=https://your-backend-api.com
